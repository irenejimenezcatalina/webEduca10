{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/primaria",
      "destination": "/refuerzo-escolar",
      "permanent": true
    },
    {
      "source": "/primaria.html",
      "destination": "/refuerzo-escolar",
      "permanent": true
    },
    {
      "source": "/eso",
      "destination": "/refuerzo-escolar",
      "permanent": true
    },
    {
      "source": "/eso.html",
      "destination": "/refuerzo-escolar",
      "permanent": true
    }
  ]
}

